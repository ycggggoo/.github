# ============================================================
# 标准前端 Node/pnpm Dockerfile 模板
#
# 使用方式: docker build -f deploy/Dockerfile.web -t myapp-web:latest xingyun-front
#
# 特性:
#   - pnpm 安装 & 构建
#   - nginx 运行
#   - 启动时注入 API 地址 (entrypoint 脚本替换占位符)
# ============================================================

FROM node:20-alpine AS build
ENV npm_config_registry=https://registry.npmmirror.com
WORKDIR /app
RUN npm i -g pnpm@9.15.9
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm build:docker

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/entrypoint-web.sh /docker-entrypoint.d/40-env.sh
RUN chmod +x /docker-entrypoint.d/40-env.sh

HEALTHCHECK --interval=30s --timeout=3s --retries=2 \
  CMD wget -qO- http://localhost:80/ || exit 1
